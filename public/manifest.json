{
  "manifest_version": 3,
  "name": "Hirivo: Real Jobs, Right People",
  "short_name": "Hirivo",
  "version": "2.14.0",
  "description": "Checks if a job is real, tells you honestly if you fit, finds who to message, and writes outreach that sounds like you.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "activeTab",
    "alarms",
    "notifications",
    "offscreen"
  ],
  "host_permissions": [
    "https://api.groq.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://openrouter.ai/*",
    "https://rdap.org/*",
    "https://dns.google/*",
    "https://boards-api.greenhouse.io/*",
    "https://api.lever.co/*",
    "https://api.ashbyhq.com/*",
    "https://*.linkedin.com/*",
    "https://*.naukri.com/*",
    "https://*.indeed.com/*",
    "https://*.wellfound.com/*",
    "https://*.instahyre.com/*",
    "https://*.cutshort.io/*",
    "https://*.foundit.in/*",
    "https://*.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://jobs.ashbyhq.com/*",
    "https://apply.workable.com/*",
    "https://remotive.com/*",
    "https://remoteok.com/*",
    "https://himalayas.app/*",
    "https://jobicy.com/*",
    "https://www.arbeitnow.com/*",
    "https://yc-oss.github.io/*",
    "https://www.ycombinator.com/*",
    "https://hn.algolia.com/*",
    "https://api.github.com/*",
    "https://news.google.com/*",
    "https://internshala.com/*",
    "https://unstop.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "https://gmail.googleapis.com/*",
    "https://oauth2.googleapis.com/*",
    "https://accounts.google.com/*",
    "https://*.chromiumapp.org/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Hirivo",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://job-boards.eu.greenhouse.io/*",
        "https://boards.eu.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.eu.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://apply.workable.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.smartrecruiters.com/*",
        "https://*.icims.com/*",
        "https://*.recruitee.com/*",
        "https://*.bamboohr.com/*",
        "https://*.keka.com/*",
        "https://*.darwinbox.in/*",
        "https://*.zohorecruit.com/*",
        "https://*.zohorecruit.in/*",
        "https://*.freshteam.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+H",
        "mac": "Alt+H"
      },
      "description": "Open Hirivo"
    }
  },
  "optional_permissions": [
    "identity"
  ]
}
